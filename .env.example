# These are example local values. Copy this file to .env and replace placeholders.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=postgres to use PostgreSQL.
DB_ENGINE=sqlite
DB_NAME=stockpilot
DB_USER=stockpilot
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
